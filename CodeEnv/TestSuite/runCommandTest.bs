#!/usr/bin/env bash

test_directory="$1"
shift
index=1
total_tests=0
passing_tests=0
failing_tests=0
statues=$?
first_error_shown=0

for i in "$test_directory"/*.in; do
    out_file="${i%.in}.out"
    actual_file=$(mktemp)
    total_tests=$((total_tests + 1))

    "$@" < "$i" > "$actual_file" 2>&1
    run_status=$?

    # A non-zero exit means the program crashed (runtime error) rather than
    # producing the wrong answer. Report it once, cleanly, without the
    # actual/expected dump repeated for every test case.
    if [ $run_status -ne 0 ]; then
        failing_tests=$((failing_tests + 1))
        if [ $first_error_shown -eq 0 ]; then
            printf "Runtime error on test case %s (exit code %s):\n" "$index" "$run_status"
            format_error "$actual_file"
            first_error_shown=1
        fi
        rm "$actual_file"
        index=$((index + 1))
        continue
    fi

    actual_output=$(sed 's/\r$//' "$actual_file" | sed 's/[[:space:]]*$//' | sed '/^[[:space:]]*$/d')

    expected_output=$(sed 's/\r$//' "$out_file" | sed 's/[[:space:]]*$//' | sed '/^[[:space:]]*$/d')

    if [ "$actual_output" = "$expected_output" ]; then
        printf "Test case %s passed\n" "$index"
        passing_tests=$((passing_tests + 1))
    else
        printf "Test case %s failed\n" "$index"
        failing_tests=$((failing_tests + 1))
        printf "Actual output:\n"
        cat "$actual_file"
        printf "Expected output:\n"
        cat "$out_file"
    fi

    rm "$actual_file"
    index=$((index + 1))
done
printf "\n Passed: %d, Failed: %d\n" "$passing_tests" "$failing_tests"

if [ $failing_tests -eq 0 ] && [ $passing_tests -eq $total_tests ]; then
    exit 0
else
    exit 1
fi

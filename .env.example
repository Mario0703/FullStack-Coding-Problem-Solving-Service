POSTGRES_URL=jdbc:postgresql://localhost:5432/minileetcode
POSTGRES_USERNAME=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# Used by the backend miniHelper (src/main/java/minicode/com/service/Ai).
# The key is read and used only on the server and is never sent to the browser.
OPENAI_API_KEY=your_openai_api_key
# Optional: model used by miniHelper (defaults to gpt-4o-mini).
# MINIHELPER_MODEL=gpt-4o-mini
# Optional: miniHelper token budget per user per window (defaults to 50000 tokens / 24h).
# MINIHELPER_TOKEN_BUDGET=50000
# MINIHELPER_TOKEN_WINDOW=PT24H

# SMTP server used by the backend to send password reset emails
# (spring-boot-starter-mail). Without MAIL_HOST the forgot-password
# flow answers "not configured" instead of failing to start.
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
# Address the reset emails are sent from.
MAIL_FROM=noreply@minileetcode.com
# Frontend origin used to build the reset link inside those emails.
FRONTEND_URL=http://localhost:5173
